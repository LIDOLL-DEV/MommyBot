DISCORD_TOKEN=your_discord_bot_token
CHANNEL_ID=your_default_discord_channel_id

# Little Log completed nightly reports; create a separate report-read token in its admin console.
MOMMYBOT_REPORTS_ENABLED=false
MOMMYBOT_REPORTS_URL=https://lidoll.dev/tracker/api/ai-reports/v1/reports
# Direct LAN backend avoids hairpin NAT; use your tracker IP, port and base path.
# MOMMYBOT_REPORTS_URL=http://10.1.1.23:4173/tracker/api/ai-reports/v1/reports
MOMMYBOT_REPORTS_TOKEN=
MOMMYBOT_REPORTS_CHANNEL_ID=
# Explicit first-run choice: future (skip existing reports) or history (publish all).
MOMMYBOT_REPORTS_INITIAL=future
MOMMYBOT_REPORTS_POLL_MS=60000
MOMMYBOT_REPORTS_DB=data/reports.db

# Welcome new human members. Enable Server Members Intent in the Discord developer portal.
# WELCOME_ENABLED=false disables greetings and the extra privileged Gateway intent.
WELCOME_CHANNEL_ID=1548848205092094034
WELCOME_RULES_CHANNEL_ID=1477184919515041874
WELCOME_RULES_MESSAGE_ID=1548865939691405423
# Dedicated welcome generation uses the .250 chat model, independently of chat/router overrides.
WELCOME_AI_BASE_URL=http://192.168.1.250:9090/v1
WELCOME_AI_TIMEOUT_MS=8000
# WELCOME_AI_ENABLED=false keeps the fixed welcome, rules link and registration instructions.

# LiD0llID SSO: register the exact HTTPS /auth/callback URL before enabling.
LIDOLLID_ENABLED=false
LIDOLLID_ISSUER=https://auth.lidoll.dev
LIDOLLID_CLIENT_ID=lidollbot
# Bot's own HTTPS hostname, proxied to port 4190. Do not put the issuer hostname here.
LIDOLLID_PUBLIC_ORIGIN=https://bot.example.com
LIDOLLID_HOST=127.0.0.1
LIDOLLID_PORT=4190
# Awarded after successful Discord confirmation; /lidollid status retries for already-linked members.
LIDOLLID_LINKED_ROLE_ID=1548848979754614857

# Online wallet: same login/consent as LiD0llID; a separate Little Log app registration is required.
# LIDOLLCOIN_CLIENT_ID and LIDOLLID_CLIENT_ID must match. Deploy both omo-trainer services first.
LIDOLLCOIN_ENABLED=false
LIDOLLCOIN_API_URL=https://lidoll.dev/tracker/api/lidollcoin/v1/
# For a direct LAN backend, use http://10.1.1.23:4173/tracker/api/lidollcoin/v1/ above.
# Browser approval stays on Little Log's public HTTPS origin even when API calls use the LAN.
LIDOLLCOIN_PUBLIC_ORIGIN=https://lidoll.dev
LIDOLLCOIN_CLIENT_ID=lidollbot

# Swear jar automatically enables with LiD0llID and online wallets.
# Charges 1 coin per swearing message in every server channel the bot can read.
# Each server's weekly lottery runs Monday 00:00 UTC (checked every minute).
# SWEAR_JAR_ENABLED=false pauses new fines; saved payments and lotteries still finish.
# Optional announcement channel; defaults to the last swear-jar channel in each server.
SWEAR_JAR_CHANNEL_ID=
# Optional comma-separated replacement for the built-in whole-word swear list.
# SWEAR_JAR_WORDS=fuck,shit,bitch,damn
# AI writes friendly swear-jar replies using LLAMA_BASE_URL and LLAMA_MODEL.
# Exact payment details and the live jar balance are always added by the bot.
# SWEAR_JAR_AI_ENABLED=false uses standard messages while keeping fines/lotteries active.
SWEAR_JAR_AI_TIMEOUT_MS=8000

# Web Diaper Gacha automatically enables when LiD0llID and wallets are enabled.
# DIAPER_GACHA_ENABLED=false pauses new transactions but keeps collection/payment recovery.
# DIAPER_GACHA_ENABLED=true
DIAPER_GACHA_ROLL_PRICE=3

# Online mode uses Little Log for all trader payments/rewards; adoption also accepts 1 star.
# With online wallets disabled, standalone installations retain the legacy local economy.
TOUHOU_ENABLED=true
TOUHOU_CHANNEL_ID=1548647250543251507
# Optional additional role allowed to award currency (Manage Server is always allowed).
TOUHOU_ADMIN_ROLE_ID=

# Cozy Hangman uses online coins: 1 coin to start, 1 coin per newly revealed letter.
# Available automatically with SSO and wallets; uncomment to pause new rounds.
# HANGMAN_ENABLED=false

# Prism Drop enables with SSO and online wallets. Pause new bets while retaining payment recovery.
# BALLDROP_ENABLED=false

# Clothes Emporium shares Atelier login/wallet and keeps Littlepottchi care free.
# CLOTHES_GACHA_ENABLED=false
# CLOTHES_GACHA_ROLL_PRICE=3
# Baby wipes are bought individually in Diaper Atelier; one clears all current body cleanup needs.
# BABYWIPES_PRICE=1
# Public /doll PNG rendering uses Python with Pillow (also used by the asset editor).
# Fedora: sudo dnf install -y python3-pillow (the deployer now installs this on updates too).
# Defaults to py -3.11 on Windows or python3 elsewhere. Optional absolute executable path:
# LITTLEPOTTCHI_PYTHON=C:\Path\To\python.exe
# Dedicated Little Log care bridge credential; same new random secret on both services.
# LITTLEPOTTCHI_BRIDGE_TOKEN=<32-or-more-random-characters>
# For Little Log -> MommyBot LAN calls, set LIDOLLID_HOST=10.1.1.23 above.
# On Little Log: LITTLEPOTTCHI_API_URL=http://10.1.1.23:4190/littlepottchi/integration/v1/
# Keep the game's public origin and browser sign-in callbacks on their public URLs.

# OpenAI-compatible llama.cpp endpoints reachable from the bot host.
LLAMA_BASE_URL=http://192.168.1.250:9090/v1
# ROUTER_LAMA_URL is the existing variable name (one L in LAMA).
ROUTER_LAMA_URL=http://192.168.1.250:9091/v1
LLAMA_MODEL=default
# Optional separate model name for the categorizer; otherwise it uses LLAMA_MODEL.
# ROUTER_MODEL=default

# Private GitHub repository activity (omit both values to disable)
GITHUB_REPOSITORY=owner/repository
GITHUB_TOKEN=github_pat_with_access_to_the_repository
GITHUB_ACTIVITY_CHANNEL_ID=discord_channel_id_for_github_updates
GITHUB_POLL_INTERVAL_MS=300000
GITHUB_MAX_ANNOUNCEMENTS=10
GITHUB_ANNOUNCE_EXISTING=false
GITHUB_AI_UPDATES=true
GITHUB_AI_TIMEOUT_MS=120000
