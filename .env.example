DISCORD_TOKEN=your_discord_bot_token
CHANNEL_ID=your_default_discord_channel_id

# LiD0llID SSO: register the exact HTTPS /auth/callback URL before enabling.
LIDOLLID_ENABLED=false
LIDOLLID_ISSUER=https://auth.lidoll.dev
LIDOLLID_CLIENT_ID=lidollbot
# Bot's own HTTPS hostname, proxied to port 4190. Do not put the issuer hostname here.
LIDOLLID_PUBLIC_ORIGIN=https://bot.example.com
LIDOLLID_HOST=127.0.0.1
LIDOLLID_PORT=4190

# Online wallet: same login/consent as LiD0llID; a separate Little Log app registration is required.
# LIDOLLCOIN_CLIENT_ID and LIDOLLID_CLIENT_ID must match. Deploy both omo-trainer services first.
LIDOLLCOIN_ENABLED=false
LIDOLLCOIN_API_URL=https://lidoll.dev/tracker/api/lidollcoin/v1/
# For a direct LAN backend, use http://10.1.1.23:4173/tracker/api/lidollcoin/v1/ above.
# Browser approval stays on Little Log's public HTTPS origin even when API calls use the LAN.
LIDOLLCOIN_PUBLIC_ORIGIN=https://lidoll.dev
LIDOLLCOIN_CLIENT_ID=lidollbot

# Online mode uses Little Log for all trader payments/rewards; adoption also accepts 1 star.
# With online wallets disabled, standalone installations retain the legacy local economy.
TOUHOU_ENABLED=true
TOUHOU_CHANNEL_ID=1548647250543251507
# Optional additional role allowed to award currency (Manage Server is always allowed).
TOUHOU_ADMIN_ROLE_ID=

# OpenAI-compatible llama.cpp endpoints reachable from the bot host.
LLAMA_BASE_URL=http://192.168.1.250:9090/v1
# ROUTER_LAMA_URL is the existing variable name (one L in LAMA).
ROUTER_LAMA_URL=http://192.168.1.250:9091/v1
LLAMA_MODEL=default

# Private GitHub repository activity (omit both values to disable)
GITHUB_REPOSITORY=owner/repository
GITHUB_TOKEN=github_pat_with_access_to_the_repository
GITHUB_ACTIVITY_CHANNEL_ID=discord_channel_id_for_github_updates
GITHUB_POLL_INTERVAL_MS=300000
GITHUB_MAX_ANNOUNCEMENTS=10
GITHUB_ANNOUNCE_EXISTING=false
GITHUB_AI_UPDATES=true
GITHUB_AI_TIMEOUT_MS=120000
